# Hourly + shortly after the timer starts (boot, package install): catches
# drift from unattended timekpr upgrades (daemon restarts, config rewrites)
# and policy.yaml edits.
# Enable:  systemctl enable --now familymon-enforce.timer
# OnActiveSec, not OnBootSec: see familymon-heartbeat.timer.
[Unit]
Description=familymon periodic enforcement reconcile

[Timer]
OnActiveSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target

# Runs the heuristic classifier every 5 minutes so the dashboard stays current.
# Enable:  systemctl enable --now familymon-classify.timer  (the postinst does)
# OnActiveSec, not OnBootSec: see familymon-heartbeat.timer.
[Unit]
Description=familymon periodic classify

[Timer]
OnActiveSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target

#!/bin/sh
# familymon CLI — runs from the bundled venv (exact dependency set that
# passed the test suite at package build time; see uv.lock in the source).
#
# -I (isolated mode): without it `python -m` puts the caller's current
# directory first on sys.path, so a `click.py` planted in a directory the
# child can write (/tmp, a shared folder) would run as root under
# `sudo familymonctl ...`, and the password-less `familymonctl mcp` sudoers
# rule would amount to a root shell for the familymon-admin group. -I also
# ignores PYTHON* environment variables and the user site-packages; the
# FAMILYMON_* variables the units set still pass through.
exec /opt/familymon/venv/bin/python3 -I -m familymon.cli "$@"

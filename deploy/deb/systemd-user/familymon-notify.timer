# Every minute; OnActiveSec (not OnBootSec) so it arms whenever the session
# starts — see classify.timer.
# Enable per user:  systemctl --user enable --now familymon-notify.timer
[Unit]
Description=familymon periodic schedule notifications

[Timer]
OnActiveSec=30s
OnUnitActiveSec=1min
AccuracySec=15s
Persistent=false

[Install]
WantedBy=timers.target

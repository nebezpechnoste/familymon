# Runs the heuristic classifier every 5 minutes so the dashboard stays current.
#
# OnActiveSec, not OnBootSec: a user timer keyed to boot never arms when the
# user logs in long after boot (e.g. after a crash the machine sat at the login
# screen for hours) — the boot offset is already past and the service has
# never been active, so nothing schedules. Relative-to-activation always arms.
[Unit]
Description=familymon periodic classify

[Timer]
OnActiveSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
